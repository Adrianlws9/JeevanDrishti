# ==============================================================================
# JEEVAN-DRISHTI FastAPI Backend Environment Configuration Example
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Security: Secret Key for Public-Health Review Actions (e.g. alert verification)
JEEVAN_REVIEWER_KEY=jeevan-drishti-reviewer-key-2026

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///backend/data/jeevan_drishti.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Bind Settings
HOST=127.0.0.1
PORT=8000
